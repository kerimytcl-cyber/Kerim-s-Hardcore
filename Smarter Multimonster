local function startFaceCycle()
    FaceCycleToken += 1
    local MyToken = FaceCycleToken

    FaceCycleActive = true

    task.spawn(function()
        local FaceIndex = 1

        while FaceCycleActive and MyToken == FaceCycleToken do
            if not Model or not Model.Parent then
                break
            end

            local RushNew = Model:FindFirstChild("RushNew")
            local Main = RushNew and RushNew:FindFirstChild("Main")
            local Face = Main and Main:FindFirstChild("Face")

            if Face then
                Face.Texture = JumpscareFaces[FaceIndex]

                FaceIndex += 1

                if FaceIndex > #JumpscareFaces then
                    FaceIndex = 1
                end
            end

            task.wait(0.1)
        end
    end)
end

local function stopFaceCycle()
    FaceCycleActive = false
    FaceCycleToken += 1
end

local function getCharacter()
    return Player.Character
end

local function getHumanoid()
    local Character = getCharacter()
    return Character and Character:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
    local Character = getCharacter()

    if not Character then
        return nil
    end

    return Character:FindFirstChild("HumanoidRootPart")
        or Character.PrimaryPart
end

local function isAlive()
    local Humanoid = getHumanoid()
    return Humanoid ~= nil and Humanoid.Health > 0
end

local function isHiding()
    local Character = getCharacter()
    return Character ~= nil and Character:GetAttribute("Hiding") == true
end

local function isHoldingCrucifix()
    local Character = getCharacter()

    if not Character then
        return false
    end

    for _, Item in ipairs(Character:GetChildren()) do
        if Item:IsA("Tool")
            and string.find(Item.Name:lower(), "crucifix", 1, true) then
            return true
        end
    end

    return false
end

local function isBeingCrucified()
    if not Model or not Model.Parent then
        return false
    end

    return Model:GetAttribute("BeingBanished") == true
end

local function canTouchKill()
    return isAlive()
        and not isHiding()
        and not isHoldingCrucifix()
        and not isBeingCrucified()
        and not TouchDeathTriggered
        and not JumpscareTriggered
end

local function getAllNodes()
    local Nodes = {}
    local Rooms = Workspace:FindFirstChild("CurrentRooms")

    if not Rooms then
        return Nodes
    end

    for _, Room in ipairs(Rooms:GetChildren()) do
        local Folder = Room:FindFirstChild("PathfindNodes")

        if Folder then
            for _, Node in ipairs(Folder:GetChildren()) do
                if Node:IsA("BasePart") then
                    table.insert(Nodes, Node)
                end
            end
        end

        for _, Name in ipairs({"RoomEntrance", "RoomExit"}) do
            local Node = Room:FindFirstChild(Name)

            if Node and Node:IsA("BasePart") then
                table.insert(Nodes, Node)
            end
        end
    end

    return Nodes
end

local function getNearestNode(Position)
    local Nearest
    local NearestDistance = math.huge

    for _, Node in ipairs(getAllNodes()) do
        local Distance = (Node.Position - Position).Magnitude

        if Distance < NearestDistance then
            NearestDistance = Distance
            Nearest = Node
        end
    end

    return Nearest
end

local function hasLineOfSight()
    if not Model or not Model.Parent or not isAlive() or isHiding() then
        return false
    end

    local Root = getRoot()

    if not Root then
        return false
    end

    local Origin = Model:GetPivot().Position
    local Direction = Root.Position - Origin

    if Direction.Magnitude <= 0.01 then
        return true
    end

    local Params = RaycastParams.new()
    Params.FilterType = Enum.RaycastFilterType.Exclude
    Params.FilterDescendantsInstances = {Model}

    local Result = Workspace:Raycast(Origin, Direction, Params)
    local Character = getCharacter()

    return Result == nil
        or (
            Character ~= nil
            and Result.Instance:IsDescendantOf(Character)
        )
end

local function movingTowardNearestNode()
    if not Model or not Model.Parent or not isAlive() or isHiding() then
        return false
    end

    local Root = getRoot()

    if not Root then
        return false
    end

    local TargetPosition = Model:GetAttribute(TargetAttribute)

    if typeof(TargetPosition) ~= "Vector3" then
        return false
    end

    local NearestNode = getNearestNode(Root.Position)

    if not NearestNode then
        return false
    end

    return (TargetPosition - NearestNode.Position).Magnitude <= 6
end

local function redFlash()
    FlashToken += 1
    local MyToken = FlashToken

    if FlashEffect then
        FlashEffect:Destroy()
        FlashEffect = nil
    end

    local Effect = Instance.new("ColorCorrectionEffect")
    Effect.Name = "MultimonsterRedFlash"
    Effect.TintColor = Color3.fromRGB(255, 25, 25)
    Effect.Brightness = 0.15
    Effect.Contrast = 0.2
    Effect.Parent = Lighting

    FlashEffect = Effect

    task.delay(0.18, function()
        if MyToken ~= FlashToken or not Effect.Parent then
            return
        end

        local Fade = TweenService:Create(
            Effect,
            TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {
                TintColor = Color3.new(1, 1, 1),
                Brightness = 0,
                Contrast = 0
            }
        )

        Fade:Play()
        Fade.Completed:Wait()

        if MyToken == FlashToken and Effect.Parent then
            Effect:Destroy()
            FlashEffect = nil
        end
    end)
end

local function stopLunge(restoreStart, startCFrame)
    LungeToken += 1

    for _, Tween in ipairs(ActiveTweens) do
        pcall(function()
            Tween:Cancel()
        end)
    end

    table.clear(ActiveTweens)

    if LungeConnection then
        LungeConnection:Disconnect()
        LungeConnection = nil
    end

    if LungeValue then
        if restoreStart and Model and Model.Parent and startCFrame then
            Model:PivotTo(startCFrame)
        end

        LungeValue:Destroy()
        LungeValue = nil
    end

    LungeActive = false
end

local function startLunge()
    if LungeActive or not isAlive() or isHiding() then
        return
    end

    if not Model or not Model.Parent or isBeingCrucified() then
        return
    end

    local Root = getRoot()

    if not Root then
        return
    end

    LungeActive = true
    LungeToken += 1

    local MyToken = LungeToken
    local StartCFrame = Model:GetPivot()
    local TotalDuration = 1
    local StartTime = os.clock()
    local EndTime = StartTime + TotalDuration
    local RetargetDistance = 0.5

    LungeValue = Instance.new("CFrameValue")
    LungeValue.Value = StartCFrame

    redFlash()

    LungeConnection = LungeValue:GetPropertyChangedSignal("Value"):Connect(function()
        if MyToken ~= LungeToken or not Model or not Model.Parent then
            return
        end

        if not isAlive() or isHiding() or isBeingCrucified() then
            stopLunge(true, StartCFrame)
            return
        end

        Model:PivotTo(LungeValue.Value)
    end)

    local function playSegment(TargetCFrame, Duration, WatchedTarget)
        if Duration <= 0 then
            return "Completed"
        end

        local Tween = TweenService:Create(
            LungeValue,
            TweenInfo.new(
                Duration,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.In
            ),
            {
                Value = TargetCFrame
            }
        )

        table.insert(ActiveTweens, Tween)
        Tween:Play()

        while true do
            if MyToken ~= LungeToken then
                return "Cancelled"
            end

            if not isAlive() or isHiding() or isBeingCrucified() then
                stopLunge(true, StartCFrame)
                return "Cancelled"
            end

            local CurrentRoot = getRoot()

            if not CurrentRoot then
                stopLunge(true, StartCFrame)
                return "Cancelled"
            end

            if (CurrentRoot.Position - WatchedTarget.Position).Magnitude >= RetargetDistance then
                Tween:Cancel()
                return "Retarget"
            end

            if Tween.PlaybackState == Enum.PlaybackState.Completed then
                return "Completed"
            end

            if os.clock() >= EndTime then
                Tween:Cancel()
                return "Completed"
            end

            task.wait(0.02)
        end
    end

    task.spawn(function()
        while os.clock() < EndTime do
            if MyToken ~= LungeToken then
                return
            end

            local CurrentRoot = getRoot()

            if not CurrentRoot then
                stopLunge(true, StartCFrame)
                return
            end

            local CurrentTarget = CurrentRoot.CFrame
            local RemainingTime = EndTime - os.clock()

            if RemainingTime <= 0 then
                break
            end

            local InboundDuration = RemainingTime * (0.65 / 1.1)
            local OutboundDuration = RemainingTime * (0.45 / 1.1)

            local InboundResult = playSegment(
                CurrentTarget,
                InboundDuration,
                CurrentTarget
            )

            if InboundResult == "Cancelled" then
                return
            end

            if InboundResult == "Retarget" then
                task.wait()
            else
                local OutboundResult = playSegment(
                    StartCFrame,
                    OutboundDuration,
                    CurrentTarget
                )

                if OutboundResult == "Cancelled" then
                    return
                end

                if OutboundResult == "Retarget" then
                    task.wait()
                else
                    break
                end
            end
        end

        if MyToken == LungeToken then
            stopLunge(false, StartCFrame)
        end
    end)
end

local function showTouchDeathHints()
    local PlayerGui = Player:FindFirstChildOfClass("PlayerGui")
    local MainUI = PlayerGui and PlayerGui:FindFirstChild("MainUI")
    local DeathUI = MainUI and MainUI:FindFirstChild("Death")

    if not DeathUI then
        return
    end

    task.spawn(function()
        local Deadline = os.clock() + 8

        while os.clock() < Deadline do
            if DeathUI.Visible then
                break
            end

            task.wait(0.05)
        end

        if not DeathUI.Visible then
            return
        end

        local Remotes = ReplicatedStorage:FindFirstChild("RemotesFolder")
        local DeathHint = Remotes and Remotes:FindFirstChild("DeathHint")

        if DeathHint and firesignal then
            pcall(function()
                firesignal(
                    DeathHint.OnClientEvent,
                    Entity.Config.Death.Hints,
                    "Blue"
                )
            end)
        end

        local GameStats = ReplicatedStorage:FindFirstChild("GameStats")
        local PlayerStats = GameStats and GameStats:FindFirstChild("Player_" .. Player.Name)
        local Total = PlayerStats and PlayerStats:FindFirstChild("Total")
        local DeathCause = Total and Total:FindFirstChild("DeathCause")

        if DeathCause and DeathCause:IsA("StringValue") then
            DeathCause.Value = Entity.Config.Death.Cause
        end
    end)
end

local function setDeathCause()
    local GameStats = ReplicatedStorage:FindFirstChild("GameStats")
    local PlayerStats = GameStats and GameStats:FindFirstChild("Player_" .. Player.Name)
    local Total = PlayerStats and PlayerStats:FindFirstChild("Total")
    local DeathCause = Total and Total:FindFirstChild("DeathCause")

    if DeathCause and DeathCause:IsA("StringValue") then
        DeathCause.Value = Entity.Config.Death.Cause
    end
end

local function disconnectTouches()
    for _, Connection in ipairs(TouchConnections) do
        Connection:Disconnect()
    end

    table.clear(TouchConnections)
end

local function cleanup()
    Active = false
    stopFaceCycle()

    if MoveConnection then
        MoveConnection:Disconnect()
        MoveConnection = nil
    end

    if TouchLockConnection then
        TouchLockConnection:Disconnect()
        TouchLockConnection = nil
    end

    disconnectTouches()
    stopLunge(false)

    FlashToken += 1

    if FlashEffect then
        FlashEffect:Destroy()
        FlashEffect = nil
    end
end

local function forceDespawn()
    Active = false
    stopFaceCycle()

    if TouchLockConnection then
        TouchLockConnection:Disconnect()
        TouchLockConnection = nil
    end

    if MoveConnection then
        MoveConnection:Disconnect()
        MoveConnection = nil
    end

    disconnectTouches()
    stopLunge(false)

    if Model and Model.Parent then
        Model:Destroy()
    end

    pcall(function()
        Entity:Despawn()
    end)
end

local function playTouchJumpscare()
    if JumpscareTriggered or not canTouchKill() then
        return
    end

    JumpscareTriggered = true
    TouchDeathTriggered = true
    Active = false

    if MoveConnection then
        MoveConnection:Disconnect()
        MoveConnection = nil
    end

    disconnectTouches()

    if LungeActive then
        stopLunge(false)
    end

    local PlayerGui = Player:FindFirstChildOfClass("PlayerGui")

    if not PlayerGui then
        forceDespawn()
        return
    end

    local Gui = Instance.new("ScreenGui")
    Gui.Name = "A60Jumpscare"
    Gui.IgnoreGuiInset = true
    Gui.DisplayOrder = 999
    Gui.ResetOnSpawn = false
    Gui.Parent = PlayerGui

    local Image = Instance.new("ImageLabel")
    Image.Name = "A60Face"
    Image.AnchorPoint = Vector2.new(0.5, 0.5)
    Image.Position = UDim2.fromScale(0.5, 0.5)
    Image.Size = UDim2.fromOffset(350, 350)
    Image.BackgroundTransparency = 1
    Image.ImageColor3 = Color3.fromRGB(255, 0, 0)
    Image.ScaleType = Enum.ScaleType.Fit
    Image.Visible = false
    Image.Parent = Gui

    local Sound = Instance.new("Sound")
    Sound.Name = "A60JumpscareSound"
    Sound.SoundId = JumpscareSoundID
    Sound.Volume = 1
    Sound.Parent = SoundService
    Sound.TimePosition = 0.5

    local AvailableFaces = table.clone(JumpscareFaces)

    local function getRandomFace()
        if #AvailableFaces == 0 then
            AvailableFaces = table.clone(JumpscareFaces)
        end

        local Index = math.random(1, #AvailableFaces)
        local SelectedFace = AvailableFaces[Index]

        table.remove(AvailableFaces, Index)

        return SelectedFace
    end

    local LockRoot = getRoot()

    if LockRoot and Model and Model.Parent then
        local LockedCFrame = LockRoot.CFrame

        TouchLockConnection = RunService.Heartbeat:Connect(function()
            if not Model or not Model.Parent then
                return
            end

            local CurrentRoot = getRoot()

            if CurrentRoot then
                Model:PivotTo(CurrentRoot.CFrame)
            else
                Model:PivotTo(LockedCFrame)
            end
        end)
    end

    task.spawn(function()
        task.wait(0.5)

        forceDespawn()

        Sound:Play()

        Image.Image = getRandomFace()
        Image.Visible = true

        for _ = 1, 5 do
            task.wait(0.05)
            Image.Image = getRandomFace()
        end

        Image.Image = getRandomFace()

        local SizeTween = TweenService:Create(
            Image,
            TweenInfo.new(0.5, Enum.EasingStyle.Linear),
            {
                Size = UDim2.fromOffset(1400, 1400)
            }
        )

        SizeTween:Play()

        setDeathCause()

        local Humanoid = getHumanoid()

        if Humanoid and Humanoid.Health > 0 then
            Humanoid.Health = 0
        end

        showTouchDeathHints()

        task.wait(0.4)

        local FadeTween = TweenService:Create(
            Image,
            TweenInfo.new(0.5, Enum.EasingStyle.Linear),
            {
                ImageTransparency = 1
            }
        )

        FadeTween:Play()
        FadeTween.Completed:Wait()

        task.wait(5)

        if Gui.Parent then
            Gui:Destroy()
        end

        if Sound.Parent then
            Sound:Destroy()
        end
    end)
end

local function checkTouch()
    if not canTouchKill() then
        return
    end

    local Character = getCharacter()

    if not Character or not Model or not Model.Parent then
        return
    end

    local BoxCFrame, BoxSize = Model:GetBoundingBox()
    local Params = OverlapParams.new()
    Params.FilterType = Enum.RaycastFilterType.Include
    Params.FilterDescendantsInstances = {Character}

    for _, Part in ipairs(Workspace:GetPartBoundsInBox(BoxCFrame, BoxSize, Params)) do
        if Part:IsDescendantOf(Character) then
            playTouchJumpscare()
            return
        end
    end
end

local function checkLunge()
    if not isAlive() or isHiding() or isBeingCrucified() then
        if LungeActive then
            stopLunge(false)
        end

        return
    end

    if hasLineOfSight() or movingTowardNearestNode() then
        startLunge()
    end
end

local function connectTouchPart(Part)
    if not Part:IsA("BasePart") then
        return
    end

    table.insert(TouchConnections, Part.Touched:Connect(function(Hit)
        if not canTouchKill() then
            return
        end

        local Character = getCharacter()

        if Character and Hit:IsDescendantOf(Character) then
            playTouchJumpscare()
        end
    end))
end

Entity:SetCallback("OnSpawned", function()
    Model = Entity.Model
    TouchDeathTriggered = false
    JumpscareTriggered = false

    if not Model or not Model:IsA("Model") then
        warn("Multimonster: spawned model is unavailable.")
        return
    end

    Active = true
    LastCheck = 0

    startFaceCycle()

    for _, Instance in ipairs(Model:GetDescendants()) do
        connectTouchPart(Instance)
    end

    table.insert(
        TouchConnections,
        Model.DescendantAdded:Connect(connectTouchPart)
    )

    MoveConnection = RunService.Heartbeat:Connect(function()
        if not Active or not Model or not Model.Parent then
            return
        end

        local Now = os.clock()

        if Now - LastCheck < 0.1 then
            return
        end

        LastCheck = Now
        checkLunge()
        checkTouch()
    end)
end)


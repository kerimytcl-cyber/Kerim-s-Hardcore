function LoadCustomInstance(assetId, parent)
    local model
    local attempts = 0

    while not model do
        if attempts >= maxLoadRetries then
            warn("❌ [LoadCustomInstance]: Maximum retry limit reached for model ID " .. tostring(assetId) .. ". Stopping attempts.")
            return nil
        end

        attempts = attempts + 1

        print("🔄 Trying to load model with Asset ID: " .. assetId .. " (Attempt " .. attempts .. "/" .. maxLoadRetries .. ")")

        local success, result = pcall(function()
            return game:GetObjects("rbxassetid://" .. assetId)[1]
        end)

        if success and result then
            model = result
            model.Parent = parent or workspace

            for _, obj in ipairs(model:GetDescendants()) do
                if obj:IsA("Script") or obj:IsA("LocalScript") then
                    obj:Destroy()
                end
            end

            pcall(function()
                model:SetAttribute("LoadedByExecutor", true)
            end)

            print("✅ [LoadCustomInstance]: Model " .. model.Name .. " successfully loaded into " .. model.Parent:GetFullName())

            return model
        end

        if attempts >= maxLoadRetries then
            warn("❌ [LoadCustomInstance]: Failed to load model ID " .. tostring(assetId) .. " after " .. maxLoadRetries .. " attempts. Giving up.")
            return nil
        end

        print("❌ [LoadCustomInstance]: Failed to load model ID " .. tostring(assetId) .. ". Retrying... 🔄")
        wait(0.5)
    end

    return nil
end

function Move(reverseDirection)
    local s = LoadCustomInstance("12254145022", workspace)

    if not s then
        warn("[Rebound] Model failed to load after maximum retries. This Rebound spawn has been stopped.")
        return
    end

    s.Parent = workspace

    local val = 60
    local killed = false
    local entity = s:FindFirstChild("Rebound")

    if not entity then
        warn("[Rebound] Entity not found in model. Aborting.")
        s:Destroy()
        return
    end

    print("[Rebound] Entity found: Hello World!")

    local latestRoom = game.ReplicatedStorage.GameData.LatestRoom.Value
    local targetRoom

    if reverseDirection then
        local oldestRoomNumber = nil

        for _, room in ipairs(workspace.CurrentRooms:GetChildren()) do
            local roomNumber = tonumber(room.Name)

            if roomNumber and (not oldestRoomNumber or roomNumber < oldestRoomNumber) then
                oldestRoomNumber = roomNumber
                targetRoom = room
            end
        end
    else
        targetRoom = workspace.CurrentRooms:FindFirstChild(tostring(latestRoom + 1))
    end

    local roomWaitStart = tick()

    while not targetRoom and tick() - roomWaitStart < 10 do
        wait(0.1)

        latestRoom = game.ReplicatedStorage.GameData.LatestRoom.Value

        if reverseDirection then
            local oldestRoomNumber = nil

            for _, room in ipairs(workspace.CurrentRooms:GetChildren()) do
                local roomNumber = tonumber(room.Name)

                if roomNumber and (not oldestRoomNumber or roomNumber < oldestRoomNumber) then
                    oldestRoomNumber = roomNumber
                    targetRoom = room
                end
            end
        else
            targetRoom = workspace.CurrentRooms:FindFirstChild(tostring(latestRoom + 1))
        end
    end

    if not targetRoom then
        warn("[Rebound] Required spawn room could not be found.")
        s:Destroy()
        return
    end

    local spawnPart

    if reverseDirection then
        spawnPart = targetRoom:FindFirstChild("RoomEntrance")
    else
        spawnPart = targetRoom:FindFirstChild("RoomExit")
    end

    local spawnWaitStart = tick()

    while not spawnPart and tick() - spawnWaitStart < 10 do
        wait(0.1)

        if reverseDirection then
            spawnPart = targetRoom:FindFirstChild("RoomEntrance")
        else
            spawnPart = targetRoom:FindFirstChild("RoomExit")
        end
    end

    if not spawnPart then
        warn("[Rebound] Required spawn part could not be found.")
        s:Destroy()
        return
    end

    entity.CFrame = spawnPart.CFrame

    print("[Rebound] Spawned at " .. spawnPart:GetFullName())

    local function canSeeTarget(target, size)
        if killed then
            return false
        end

        local origin = entity.Position
        local direction = (target.HumanoidRootPart.Position - origin).unit * size
        local ray = Ray.new(origin, direction)
        local hit = workspace:FindPartOnRay(ray, entity)

        if hit and hit:IsDescendantOf(target) then
            killed = true
            return true
        end

        return false
    end

    if reverseDirection then
        wait(5)
    else
        wait(8)
    end

    local reboundRumble = Instance.new("Sound")
    reboundRumble.Name = "ReboundRumble"
    reboundRumble.SoundId = GitAud(
        "https://sourcemirrors.org/hosted/43577-rebound_rumble.mp3.mpeg.mp3",
        "rebound_rumble"
    )
    reboundRumble.Parent = workspace
    reboundRumble.Volume = 1
    reboundRumble.PlaybackSpeed = 1
    reboundRumble:Play()

    spawn(function()
        while entity ~= nil and entity.Parent ~= nil do
            wait(0.5)

            local v = game.Players.LocalPlayer

            if v.Character and not v.Character:GetAttribute("Hiding") then
                if canSeeTarget(v.Character, 50) then
                    local ReboundJs = Instance.new("ScreenGui")
                    local Static = Instance.new("ImageLabel")
                    local Rebound = Instance.new("ImageLabel")
                    local JSSIZE = Instance.new("ImageLabel")

                    ReboundJs.Name = "ReboundJs"
                    ReboundJs.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")

                    Static.Name = "Static"
                    Static.Parent = ReboundJs
                    Static.BackgroundTransparency = 1
                    Static.Size = UDim2.new(11, 0, 111, 0)
                    Static.Image = "rbxassetid://236543215"
                    Static.ImageTransparency = 1

                    Rebound.Name = "Rebound"
                    Rebound.Parent = ReboundJs
                    Rebound.BackgroundTransparency = 1
                    Rebound.Position = UDim2.new(0.4866, 0, 0.4793, 0)
                    Rebound.Size = UDim2.new(0.0267, 0, 0.0387, 0)
                    Rebound.Image = "rbxassetid://12743630371"
                    Rebound.ScaleType = Enum.ScaleType.Fit

                    JSSIZE.Name = "JSSIZE"
                    JSSIZE.Parent = ReboundJs
                    JSSIZE.BackgroundTransparency = 1
                    JSSIZE.Position = UDim2.new(-0.586, 0, -1.251, 0)
                    JSSIZE.Size = UDim2.new(2.128, 0, 3.081, 0)
                    JSSIZE.Visible = false
                    JSSIZE.Image = "rbxassetid://12743630371"
                    JSSIZE.ScaleType = Enum.ScaleType.Fit

                    coroutine.wrap(function()
                        local script = Static

                        while true do
                            script.Image = "rbxassetid://236543215"
                            task.wait(0.002)
                            script.Rotation = 0
                            task.wait(0.002)
                            script.Rotation = 180
                            task.wait(0.002)
                            script.Image = "rbxassetid://236777652"
                            task.wait(0.002)
                            script.Rotation = 0
                            task.wait(0.002)
                            script.Rotation = 180
                            task.wait(0.002)
                        end
                    end)()

                    coroutine.wrap(function()
                        local Plr = game.Players.LocalPlayer
                        local gui = ReboundJs
                        local static = gui.Static
                        local jspos = gui.JSSIZE

                        game.TweenService:Create(static, TweenInfo.new(0.5), {ImageTransparency = 0.8}):Play()
                        game.TweenService:Create(gui.Rebound, TweenInfo.new(0.5), {Size = jspos.Size, Position = jspos.Position}):Play()

                        task.spawn(function()
                            wait(0.3)

                            Plr.Character:FindFirstChildWhichIsA("Humanoid"):TakeDamage(100)

                            game.ReplicatedStorage.GameStats["Player_" .. Plr.Name].Total.DeathCause.Value = "Rebound"

                            game.ReplicatedStorage.Bricks.DeathHint.OnClientEvent:Fire({
                                "You died to who you call Rebound...",
                                "He makes his presence known and keeps coming back...",
                                "Hide when this happens!"
                            })
                        end)

                        wait(0.5)

                        game.TweenService:Create(static, TweenInfo.new(1), {ImageTransparency = 1}):Play()
                        game.TweenService:Create(gui.Rebound, TweenInfo.new(0.3), {ImageTransparency = 1}):Play()

                        wait(1)
                        gui:Destroy()
                    end)()
                end
            end

            if entity and v.Character and v.Character:FindFirstChild("HumanoidRootPart") then
                if (entity.Position - v.Character.HumanoidRootPart.Position).Magnitude <= val then
                    camShake:Start()
                    camShake:ShakeOnce(17, 6, 0.1, 1)
                end
            end
        end
    end)

    local gruh = workspace.CurrentRooms

    if reverseDirection then
        local oldestRoomNumber = nil

        for _, room in ipairs(gruh:GetChildren()) do
            local roomNumber = tonumber(room.Name)

            if roomNumber and (not oldestRoomNumber or roomNumber < oldestRoomNumber) then
                oldestRoomNumber = roomNumber
            end
        end

        if oldestRoomNumber then
            for i = oldestRoomNumber, latestRoom do
                if gruh:FindFirstChild(tostring(i)) then
                    local room = gruh[tostring(i)]

                    if room:FindFirstChild("RoomExit") then
                        local a = room.RoomExit

                        local tween = game.TweenService:Create(
                            entity,
                            TweenInfo.new(2, Enum.EasingStyle.Sine),
                            {CFrame = a.CFrame}
                        )

                        tween:Play()
                        tween.Completed:Wait()
                    end
                end
            end
        end
    else
        for i = latestRoom, 1, -1 do
            if gruh:FindFirstChild(tostring(i)) then
                local room = gruh[tostring(i)]

                if room:FindFirstChild("RoomEntrance") then
                    local a = room.RoomExit

                    local tween = game.TweenService:Create(
                        entity,
                        TweenInfo.new(2, Enum.EasingStyle.Sine),
                        {CFrame = a.CFrame}
                    )

                    tween:Play()
                    tween.Completed:Wait()
                end
            end
        end
    end

    entity.Anchored = false
    entity.CanCollide = false

    game.Debris:AddItem(s, 5)
end

function Rebound()
    local Warn = Instance.new("ColorCorrectionEffect", game.Lighting)

    Warn.TintColor = Color3.fromRGB(65, 138, 255)
    Warn.Saturation = -0.7
    Warn.Contrast = 0.2

    game.TweenService:Create(Warn, TweenInfo.new(15), {
        TintColor = Color3.fromRGB(255, 255, 255),
        Saturation = 0,
        Contrast = 0
    }):Destroy()

    camShake:Start()
    camShake:ShakeOnce(10, 3, 0.1, 6, 2, 0.5)

    pcall(function()
        Move(false)
    end)

    while maxRebounds > 0 do
        game.ReplicatedStorage.GameData.LatestRoom.Changed:Wait()

        pcall(function()
            Move(maxRebounds % 2 == 1)
        end)

        maxRebounds = maxRebounds - 1
    end

    wait(15.3)
    Warn:Destroy()
end

pcall(Rebound)

